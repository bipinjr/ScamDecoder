# Copy to .env.local and fill in. Never commit .env.local.
GROQ_API_KEY=
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=

# Telegram bot: token from @BotFather; the secret is any long random string you choose.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp bot through Twilio (sandbox or a real number).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: the exact public webhook URL, if signature checks fail behind a proxy.
WHATSAPP_WEBHOOK_URL=

# Optional feeds
SAFE_BROWSING_KEY=
ABUSECH_KEY=
